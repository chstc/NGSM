import { Theme } from "theme.slint";
import { Card, StatCard, EventRow } from "widgets.slint";

export struct EventEntry {
    label: string,
    time: string,
    kind: int, // 0 started (green), 1 stopped (amber), 2 info (cyan)
}

export component DashboardView inherits Rectangle {
    background: transparent;

    // Tile 1: Managed services (with Running sub-count).
    in property <string> stat-total: "0";
    in property <string> stat-running: "0";

    // Tile 2: Stopped (with Manual-start sub-count).
    in property <string> stat-stopped: "0";
    in property <string> stat-manual-start: "0";

    // Tile 3: Failed (with Auto-recovering sub-count).
    in property <string> stat-failed: "0";
    in property <string> stat-auto-recovering: "0";

    // Tile 4: Availability (XXd) with sparkline.
    in property <string> stat-availability-title: "Availability (30d)";
    in property <string> stat-availability-value: "—";
    in property <string> stat-availability-line: "";
    in property <string> stat-availability-area: "";

    in property <[EventEntry]> events;

    VerticalLayout {
        spacing: Theme.gap;

        // --- stat cards ---
        HorizontalLayout {
            spacing: Theme.gap;
            StatCard {
                title: "Managed services";
                value: root.stat-total;
                accent: Theme.green;
                caption: "Running";
                caption-value: root.stat-running;
            }
            StatCard {
                title: "Stopped";
                value: root.stat-stopped;
                accent: Theme.cyan;
                caption: "Manual start";
                caption-value: root.stat-manual-start;
            }
            StatCard {
                title: "Failed";
                value: root.stat-failed;
                accent: Theme.amber;
                caption: "Auto-recovering";
                caption-value: root.stat-auto-recovering;
            }
            StatCard {
                title: root.stat-availability-title;
                value: root.stat-availability-value;
                accent: Theme.green;
                show-chart: true;
                chart-line: root.stat-availability-line;
                chart-area: root.stat-availability-area;
            }
        }

        // --- recent events ---
        Card {
            VerticalLayout {
                padding: 20px;
                alignment: start;
                spacing: 0px;
                Text {
                    text: "Recent Events";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 800;
                }
                Rectangle { height: 10px; }
                for e in root.events : EventRow {
                    label: e.label;
                    time: e.time;
                    tint: e.kind == 1 ? Theme.amber
                        : e.kind == 2 ? Theme.cyan
                        : Theme.green;
                }
            }
        }
    }
}
