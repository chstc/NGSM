import { Theme } from "theme.slint";
import { Card, StatCard, EventRow } from "widgets.slint";

export struct EventEntry {
    label: string,
    time: string,
    kind: int, // 0 started (green), 1 stopped (amber), 2 info (cyan)
}

export component DashboardView inherits Rectangle {
    background: transparent;
    in property <string> stat-total: "0";
    in property <string> stat-running: "0";
    in property <string> stat-stopped: "0";
    in property <string> stat-attention: "0";
    in property <[EventEntry]> events;

    VerticalLayout {
        spacing: Theme.gap;

        // --- stat cards ---
        HorizontalLayout {
            spacing: Theme.gap;
            StatCard {
                title: "Managed services";
                value: root.stat-total;
                accent: Theme.green;
                caption: "tracked by NGSM";
                caption-value: "";
            }
            StatCard {
                title: "Running";
                value: root.stat-running;
                accent: Theme.green;
                caption: "healthy";
                caption-value: "";
            }
            StatCard {
                title: "Stopped";
                value: root.stat-stopped;
                accent: Theme.cyan;
                caption: "idle";
                caption-value: "";
            }
            StatCard {
                title: "Needs attention";
                value: root.stat-attention;
                accent: Theme.amber;
                caption: "auto-start, stopped";
                caption-value: "";
            }
        }

        // --- recent events ---
        Card {
            VerticalLayout {
                padding: 20px;
                alignment: start;
                spacing: 0px;
                Text {
                    text: "Recent Events";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 800;
                }
                Rectangle { height: 10px; }
                for e in root.events : EventRow {
                    label: e.label;
                    time: e.time;
                    tint: e.kind == 1 ? Theme.amber
                        : e.kind == 2 ? Theme.cyan
                        : Theme.green;
                }
            }
        }
    }
}
