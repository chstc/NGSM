// NGSM Cockpit — design tokens. One place for every colour and metric.
export global Theme {
    // Surfaces
    out property <color> bg:          #090d16;
    out property <color> sidebar-bg:  #0b0f1a;
    out property <color> card-bg:     #121a2b;
    out property <color> card-border: #202c45;
    out property <color> divider:     #1b2438;

    // Text
    out property <color> text:        #e8edf7;
    out property <color> text-dim:    #8b98b4;
    out property <color> text-faint:  #596884;

    // Accents
    out property <color> green: #34e07e;
    out property <color> cyan:  #3fa9ff;
    out property <color> amber: #f5b53d;
    out property <color> red:   #ff5d6c;

    // Interaction overlays
    out property <color> hover: #ffffff12;
    out property <color> sel:   #3fa9ff24;

    // Modal backdrop + elevation
    out property <color> overlay: #000000aa;
    out property <color> shadow:  #00000066;

    // Foreground used on top of accent (green) fills.
    out property <color> on-accent: #06210f;

    // Geometry
    out property <length> radius:    14px;
    out property <length> radius-sm: 9px;
    out property <length> gap:       16px;
    out property <length> pad:       24px;
}
