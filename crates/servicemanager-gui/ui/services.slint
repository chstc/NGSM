import { Theme } from "theme.slint";
import { Card, Pill, AccentButton, GhostButton, Caret, SortHeader, CheckBox } from "widgets.slint";
import { ListView } from "std-widgets.slint";

export struct ServiceRow {
    name: string,
    display: string,
    kind: string,
    state: string,
    startup: string,
    running: bool,
    image-path: string,
    application: string,
    arguments: string,
    working-dir: string,
    account: string,
    pid: string,
    stdout-log: string,
    can-start: bool,
    can-stop: bool,
    can-restart: bool,
    can-pause: bool,
    can-continue: bool,
    can-rotate: bool,
    can-edit: bool,
    can-remove: bool,
    can-processes: bool,
}

component DetailLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 32px;
    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.text-faint;
            font-size: 12px;
            width: 116px;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.divider;
    }
}

export component ServicesView inherits Rectangle {
    background: transparent;
    in property <[ServiceRow]> rows;
    in property <bool> elevated: false;
    in-out property <int> selected: 0;
    in-out property <bool> managed-only: true;
    in-out property <bool> auto-refresh: false;
    callback refresh();
    callback install();
    callback action(string, string);
    callback filter-changed(bool);
    callback running-changed(bool);
    in-out property <bool> running-only;
    callback sort-changed(int);
    callback auto-refresh-changed(bool);
    in property <int> sort-column;
    in property <bool> sort-ascending;

    // Bounds-guard: read `rows[selected]` only when `selected` is a valid
    // index into the current model. During refresh/filter/search/sort the
    // Rust side rebuilds `rows` and may update `selected` a frame later;
    // without the explicit `selected < rows.length` check, Slint can
    // either panic or silently read stale data for the just-shorter model.
    property <ServiceRow> current: root.selected >= 0 && root.selected < root.rows.length
        ? root.rows[root.selected]
        : {};

    HorizontalLayout {
        spacing: Theme.gap;

        // --- toolbar + table ---
        VerticalLayout {
            horizontal-stretch: 3;
            spacing: Theme.gap;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                AccentButton {
                    text: "Install service";
                    enabled: root.elevated;
                    clicked => { root.install(); }
                }
                GhostButton {
                    text: "Refresh";
                    clicked => { root.refresh(); }
                }
                Rectangle {
                    width: 138px;
                    height: 36px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: root.auto-refresh ? Theme.green : Theme.card-border;
                    background: auto-ta.has-hover ? Theme.card-bg.brighter(0.5) : Theme.card-bg;
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;
                        Rectangle {
                            width: 8px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.auto-refresh ? Theme.green : Theme.text-faint;
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Text {
                            text: "Auto-refresh";
                            color: root.auto-refresh ? Theme.text : Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    auto-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.auto-refresh = !root.auto-refresh;
                            root.auto-refresh-changed(root.auto-refresh);
                        }
                    }
                }
                Rectangle {
                    width: 156px;
                    height: 36px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    background: filt.has-hover ? Theme.card-bg.brighter(0.5) : Theme.card-bg;
                    HorizontalLayout {
                        padding-left: 13px;
                        padding-right: 30px;
                        Text {
                            text: root.managed-only ? "Managed only" : "All services";
                            color: Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    Caret {
                        x: parent.width - self.width - 13px;
                        y: (parent.height - self.height) / 2;
                    }
                    filt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { filter-popup.show(); }
                    }
                    filter-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 4px;
                        width: 156px;
                        height: 74px;
                        close-policy: close-on-click;
                        Rectangle {
                            background: Theme.card-bg;
                            border-color: Theme.card-border;
                            border-width: 1px;
                            border-radius: Theme.radius-sm;
                            VerticalLayout {
                                padding: 5px;
                                spacing: 2px;
                                Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    background: m-opt.has-hover ? Theme.hover : transparent;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        Text {
                                            text: "Managed only";
                                            color: Theme.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    m-opt := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.managed-only = true;
                                            root.filter-changed(true);
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    background: a-opt.has-hover ? Theme.hover : transparent;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        Text {
                                            text: "All services";
                                            color: Theme.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    a-opt := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.managed-only = false;
                                            root.filter-changed(false);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                CheckBox {
                    label: "Running only";
                    checked <=> root.running-only;
                    toggled(v) => { root.running-changed(v); }
                }
                Rectangle { }
            }

            Card {
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            SortHeader {
                                label: "NAME";
                                column: 0;
                                sort-column: root.sort-column;
                                ascending: root.sort-ascending;
                                clicked(c) => { root.sort-changed(c); }
                                width: 148px;
                            }
                            SortHeader {
                                label: "DISPLAY NAME";
                                column: 1;
                                sort-column: root.sort-column;
                                ascending: root.sort-ascending;
                                clicked(c) => { root.sort-changed(c); }
                                horizontal-stretch: 1;
                            }
                            SortHeader {
                                label: "KIND";
                                column: 2;
                                sort-column: root.sort-column;
                                ascending: root.sort-ascending;
                                clicked(c) => { root.sort-changed(c); }
                                width: 74px;
                            }
                            SortHeader {
                                label: "STATE";
                                column: 3;
                                sort-column: root.sort-column;
                                ascending: root.sort-ascending;
                                clicked(c) => { root.sort-changed(c); }
                                width: 104px;
                            }
                            SortHeader {
                                label: "STARTUP";
                                column: 4;
                                sort-column: root.sort-column;
                                ascending: root.sort-ascending;
                                clicked(c) => { root.sort-changed(c); }
                                width: 88px;
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for svc[idx] in root.rows : Rectangle {
                            height: 46px;
                            border-radius: 7px;
                            background: idx == root.selected ? Theme.sel
                                : rta.has-hover ? Theme.hover
                                : transparent;
                            rta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected = idx;
                                }
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                Text {
                                    text: svc.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    width: 148px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: svc.display;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: svc.kind;
                                    color: Theme.text-faint;
                                    font-size: 12px;
                                    width: 74px;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 104px;
                                    Pill {
                                        x: 0px;
                                        y: (parent.height - self.height) / 2;
                                        text: svc.state;
                                        tint: svc.running ? Theme.green : Theme.amber;
                                    }
                                }
                                Text {
                                    text: svc.startup;
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    width: 88px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- detail pane ---
        VerticalLayout {
            horizontal-stretch: 2;
            spacing: Theme.gap;
            Rectangle { height: 36px; }
            Card {
                VerticalLayout {
                    padding: 24px;
                    alignment: start;
                    spacing: 0px;
                    Text {
                        text: root.current.display;
                        color: Theme.text;
                        font-size: 21px;
                        font-weight: 800;
                        overflow: elide;
                    }
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Pill {
                            text: root.current.state;
                            tint: root.current.running ? Theme.green : Theme.amber;
                        }
                        Pill {
                            text: root.current.kind;
                            tint: Theme.cyan;
                        }
                    }
                    Rectangle { height: 18px; }
                    DetailLine { label: "Service name"; value: root.current.name; }
                    DetailLine { label: "Application"; value: root.current.application; }
                    DetailLine { label: "Arguments"; value: root.current.arguments; }
                    DetailLine { label: "Working dir"; value: root.current.working-dir; }
                    DetailLine { label: "Startup type"; value: root.current.startup; }
                    DetailLine { label: "stdout log"; value: root.current.stdout-log; }
                    Rectangle { height: 22px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        AccentButton {
                            text: "Start";
                            enabled: root.current.can-start;
                            clicked => { root.action("start", root.current.name); }
                        }
                        GhostButton {
                            text: "Stop";
                            enabled: root.current.can-stop;
                            clicked => { root.action("stop", root.current.name); }
                        }
                        GhostButton {
                            text: "Restart";
                            enabled: root.current.can-restart;
                            clicked => { root.action("restart", root.current.name); }
                        }
                    }
                    Rectangle { height: 9px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        GhostButton {
                            text: "Pause";
                            enabled: root.current.can-pause;
                            clicked => { root.action("pause", root.current.name); }
                        }
                        GhostButton {
                            text: "Continue";
                            enabled: root.current.can-continue;
                            clicked => { root.action("continue", root.current.name); }
                        }
                        GhostButton {
                            text: "Rotate logs";
                            enabled: root.current.can-rotate;
                            clicked => { root.action("rotate", root.current.name); }
                        }
                    }
                    Rectangle { height: 9px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        GhostButton {
                            text: "Edit…";
                            enabled: root.current.can-edit;
                            clicked => { root.action("edit", root.current.name); }
                        }
                        GhostButton {
                            text: "Processes…";
                            enabled: root.current.can-processes;
                            clicked => { root.action("processes", root.current.name); }
                        }
                        GhostButton {
                            text: "Remove";
                            tint: Theme.red;
                            enabled: root.current.can-remove;
                            clicked => { root.action("remove", root.current.name); }
                        }
                    }
                }
            }
        }
    }
}
