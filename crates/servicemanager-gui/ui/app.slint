import { Theme } from "theme.slint";
import { NavItem } from "widgets.slint";
import { DashboardView, EventEntry } from "dashboard.slint";
import { ServicesView, ServiceRow } from "services.slint";
import { LogsView, RecoveryView, SettingsView } from "secondary.slint";

export component MainWindow inherits Window {
    title: "NGSM — Service Manager";
    icon: @image-url("../assets/logo.png");
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    preferred-width: 1260px;
    preferred-height: 820px;
    min-width: 1040px;
    min-height: 700px;

    property <int> view: 0;

    in property <bool> elevated: false;
    in property <[ServiceRow]> services;
    in-out property <int> selected-service: 0;
    in property <string> stat-total: "0";
    in property <string> stat-running: "0";
    in property <string> stat-stopped: "0";
    in property <string> stat-attention: "0";
    in property <[EventEntry]> events;
    in property <string> status-text;
    callback refresh();
    callback install();
    callback action(string, string);
    callback filter-changed(bool);
    callback search-changed(string);
    callback row-selected(int);
    callback relaunch-admin();

    HorizontalLayout {
        spacing: 0px;

        // === Sidebar ===
        Rectangle {
            width: 236px;
            background: Theme.sidebar-bg;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.divider;
            }
            VerticalLayout {
                padding: 20px;
                spacing: 7px;

                // brand
                HorizontalLayout {
                    spacing: 11px;
                    alignment: start;
                    Rectangle {
                        width: 34px;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 9px;
                            background: @linear-gradient(135deg, #34e07e 0%, #3fa9ff 100%);
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "N";
                                color: #06210f;
                                font-size: 20px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "NGSM";
                            color: Theme.text;
                            font-size: 19px;
                            font-weight: 800;
                        }
                        Text {
                            text: "Service Manager";
                            color: Theme.text-faint;
                            font-size: 10px;
                            letter-spacing: 0.5px;
                        }
                    }
                }
                Rectangle { height: 18px; }

                NavItem { label: "Dashboard"; icon: "dashboard"; active: root.view == 0; clicked => { root.view = 0; } }
                NavItem { label: "Services";  icon: "services";  active: root.view == 1; clicked => { root.view = 1; } }
                NavItem { label: "Logs";      icon: "logs";      active: root.view == 2; clicked => { root.view = 2; } }
                NavItem { label: "Recovery";  icon: "recovery";  active: root.view == 3; clicked => { root.view = 3; } }
                NavItem { label: "Settings";  icon: "settings";  active: root.view == 4; clicked => { root.view = 4; } }

                Rectangle { }

                Rectangle { height: 1px; background: Theme.divider; }
                Rectangle { height: 14px; }
                Rectangle {
                    height: 22px;
                    HorizontalLayout {
                        spacing: 9px;
                        alignment: start;
                        Rectangle {
                            width: 8px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.elevated ? Theme.green : Theme.amber;
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Text {
                            text: root.elevated ? "Administrator session" : "Read-only — relaunch";
                            color: Theme.text-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        enabled: !root.elevated;
                        mouse-cursor: pointer;
                        clicked => { root.relaunch-admin(); }
                    }
                }
                Rectangle { height: 6px; }
                Text {
                    text: "NGSM 0.1.0";
                    color: Theme.text-faint;
                    font-size: 11px;
                }
            }
        }

        // === Main area ===
        Rectangle {
            background: Theme.bg;
            VerticalLayout {
                padding: Theme.pad;
                spacing: 20px;

                // header
                HorizontalLayout {
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.view == 0 ? "Dashboard"
                                : root.view == 1 ? "Services"
                                : root.view == 2 ? "Logs"
                                : root.view == 3 ? "Recovery"
                                : "Settings";
                            color: Theme.text;
                            font-size: 23px;
                            font-weight: 800;
                        }
                        Text {
                            text: root.view == 0 ? "Live health of every managed service"
                                : root.view == 1 ? "Browse, install and control services"
                                : root.view == 2 ? "Redirected stdout / stderr output"
                                : root.view == 3 ? "Restart and exit-code policy"
                                : "NGSM preferences";
                            color: Theme.text-faint;
                            font-size: 12px;
                        }
                    }
                    Rectangle { }
                    Rectangle {
                        width: 232px;
                        height: 38px;
                        border-radius: Theme.radius-sm;
                        background: Theme.card-bg;
                        border-width: 1px;
                        border-color: Theme.card-border;
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 13px;
                            spacing: 9px;
                            Rectangle {
                                width: 12px;
                                Rectangle {
                                    width: 11px;
                                    height: 11px;
                                    x: 0px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 5.5px;
                                    border-width: 1.5px;
                                    border-color: Theme.text-faint;
                                    background: transparent;
                                }
                            }
                            Rectangle {
                                search-box := TextInput {
                                    color: Theme.text;
                                    font-size: 13px;
                                    single-line: true;
                                    vertical-alignment: center;
                                    edited => { root.search-changed(self.text); }
                                }
                                Text {
                                    text: "Search services";
                                    color: Theme.text-faint;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    visible: search-box.text == "";
                                }
                            }
                        }
                    }
                }

                // body
                Rectangle {
                    if root.view == 0 : DashboardView {
                        stat-total: root.stat-total;
                        stat-running: root.stat-running;
                        stat-stopped: root.stat-stopped;
                        stat-attention: root.stat-attention;
                        events: root.events;
                    }
                    if root.view == 1 : ServicesView {
                        rows: root.services;
                        elevated: root.elevated;
                        selected <=> root.selected-service;
                        refresh => { root.refresh(); }
                        install => { root.install(); }
                        action(verb, name) => { root.action(verb, name); }
                        filter-changed(managed) => { root.filter-changed(managed); }
                        row-selected(idx) => { root.row-selected(idx); }
                    }
                    if root.view == 2 : LogsView { }
                    if root.view == 3 : RecoveryView { }
                    if root.view == 4 : SettingsView { }
                }

                // status bar
                Text {
                    text: root.status-text;
                    color: Theme.text-faint;
                    font-size: 12px;
                }
            }
        }
    }
}
