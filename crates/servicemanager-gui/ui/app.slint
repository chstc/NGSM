import { Theme } from "theme.slint";
import { NavItem } from "widgets.slint";
import { DashboardView, EventEntry } from "dashboard.slint";
import { ServicesView, ServiceRow } from "services.slint";
import { LogsView, RecoveryView, SettingsView } from "secondary.slint";
import { InstallDialog, EditDialog, RemoveDialog, ProcessesDialog, ProcessRow } from "dialogs.slint";

export component MainWindow inherits Window {
    title: "NGSM — Service Manager";
    icon: @image-url("../assets/logo.png");
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    preferred-width: 1260px;
    preferred-height: 820px;
    min-width: 1040px;
    min-height: 700px;

    property <int> view: 0;

    in property <bool> elevated: false;
    in property <[ServiceRow]> services;
    in-out property <int> selected-service: 0;
    in-out property <bool> auto-refresh: false;
    in-out property <bool> running-only;
    callback running-changed(bool);
    in property <string> stat-total: "0";
    in property <string> stat-running: "0";
    in property <string> stat-stopped: "0";
    in property <string> stat-attention: "0";
    in property <[EventEntry]> events;
    in property <string> status-text;
    callback refresh();
    callback install();
    callback action(string, string);
    callback filter-changed(bool);
    callback search-changed(string);
    callback row-selected(int);
    callback relaunch-admin();
    callback sort-changed(int);
    in property <int> sort-column;
    in property <bool> sort-ascending;

    in property <int> active-modal: 0;
    in-out property <string> modal-name;
    in-out property <string> modal-display;
    in-out property <string> modal-application;
    in-out property <string> modal-arguments;
    in-out property <string> modal-working-dir;
    in-out property <string> modal-stdout;
    in-out property <string> modal-stderr;
    in-out property <int> modal-start-type;
    in property <string> modal-error;
    in property <string> modal-service-name;
    in property <[ProcessRow]> modal-processes;
    callback modal-install-submit();
    callback modal-edit-submit();
    callback modal-remove-confirm();
    callback modal-browse-app();
    callback modal-cancel();
    in property <int> modal-sort-column;
    in property <bool> modal-sort-ascending;
    callback modal-sort-changed(int);

    in property <string> log-service-name;
    in property <bool> log-stderr;
    in property <string> log-status;
    in property <[string]> log-lines;
    callback logs-reload();
    callback logs-set-stderr(bool);

    HorizontalLayout {
        spacing: 0px;

        // === Sidebar ===
        Rectangle {
            width: 236px;
            background: Theme.sidebar-bg;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.divider;
            }
            VerticalLayout {
                padding: 20px;
                spacing: 7px;

                // brand
                HorizontalLayout {
                    spacing: 11px;
                    alignment: start;
                    Rectangle {
                        width: 34px;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 9px;
                            background: @linear-gradient(135deg, #34e07e 0%, #3fa9ff 100%);
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "N";
                                color: #06210f;
                                font-size: 20px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "NGSM";
                            color: Theme.text;
                            font-size: 19px;
                            font-weight: 800;
                        }
                        Text {
                            text: "Service Manager";
                            color: Theme.text-faint;
                            font-size: 10px;
                            letter-spacing: 0.5px;
                        }
                    }
                }
                Rectangle { height: 18px; }

                NavItem { label: "Dashboard"; icon: "dashboard"; active: root.view == 0; clicked => { root.view = 0; } }
                NavItem { label: "Services";  icon: "services";  active: root.view == 1; clicked => { root.view = 1; } }
                NavItem { label: "Logs";      icon: "logs";      active: root.view == 2; clicked => { root.view = 2; root.logs-reload(); } }
                NavItem { label: "Recovery";  icon: "recovery";  active: root.view == 3; clicked => { root.view = 3; } }
                NavItem { label: "Settings";  icon: "settings";  active: root.view == 4; clicked => { root.view = 4; } }

                Rectangle { }

                Rectangle { height: 1px; background: Theme.divider; }
                Rectangle { height: 14px; }
                Rectangle {
                    height: 22px;
                    HorizontalLayout {
                        spacing: 9px;
                        alignment: start;
                        Rectangle {
                            width: 8px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.elevated ? Theme.green : Theme.amber;
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Text {
                            text: root.elevated ? "Administrator session" : "Read-only — relaunch";
                            color: Theme.text-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        enabled: !root.elevated;
                        mouse-cursor: pointer;
                        clicked => { root.relaunch-admin(); }
                    }
                }
                Rectangle { height: 6px; }
                Text {
                    text: "NGSM 0.1.0";
                    color: Theme.text-faint;
                    font-size: 11px;
                }
            }
        }

        // === Main area ===
        Rectangle {
            background: Theme.bg;
            VerticalLayout {
                padding: Theme.pad;
                spacing: 20px;

                // header
                HorizontalLayout {
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.view == 0 ? "Dashboard"
                                : root.view == 1 ? "Services"
                                : root.view == 2 ? "Logs"
                                : root.view == 3 ? "Recovery"
                                : "Settings";
                            color: Theme.text;
                            font-size: 23px;
                            font-weight: 800;
                        }
                        Text {
                            text: root.view == 0 ? "Live health of every managed service"
                                : root.view == 1 ? "Browse, install and control services"
                                : root.view == 2 ? "Redirected stdout / stderr output"
                                : root.view == 3 ? "Restart and exit-code policy"
                                : "NGSM preferences";
                            color: Theme.text-faint;
                            font-size: 12px;
                        }
                    }
                    Rectangle { }
                    Rectangle {
                        width: 232px;
                        height: 38px;
                        border-radius: Theme.radius-sm;
                        background: Theme.card-bg;
                        border-width: 1px;
                        border-color: Theme.card-border;
                        HorizontalLayout {
                            padding-left: 13px;
                            padding-right: 13px;
                            spacing: 9px;
                            Rectangle {
                                width: 12px;
                                Rectangle {
                                    width: 11px;
                                    height: 11px;
                                    x: 0px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 5.5px;
                                    border-width: 1.5px;
                                    border-color: Theme.text-faint;
                                    background: transparent;
                                }
                            }
                            Rectangle {
                                search-box := TextInput {
                                    color: Theme.text;
                                    font-size: 13px;
                                    single-line: true;
                                    vertical-alignment: center;
                                    edited => { root.search-changed(self.text); }
                                }
                                Text {
                                    text: "Search services";
                                    color: Theme.text-faint;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    visible: search-box.text == "";
                                }
                            }
                        }
                    }
                }

                // body
                Rectangle {
                    if root.view == 0 : DashboardView {
                        stat-total: root.stat-total;
                        stat-running: root.stat-running;
                        stat-stopped: root.stat-stopped;
                        stat-attention: root.stat-attention;
                        events: root.events;
                    }
                    if root.view == 1 : ServicesView {
                        rows: root.services;
                        elevated: root.elevated;
                        auto-refresh <=> root.auto-refresh;
                        running-only <=> root.running-only;
                        selected <=> root.selected-service;
                        sort-column: root.sort-column;
                        sort-ascending: root.sort-ascending;
                        refresh => { root.refresh(); }
                        install => { root.install(); }
                        action(verb, name) => { root.action(verb, name); }
                        filter-changed(managed) => { root.filter-changed(managed); }
                        running-changed(v) => { root.running-changed(v); }
                        row-selected(idx) => { root.row-selected(idx); }
                        sort-changed(c) => { root.sort-changed(c); }
                    }
                    if root.view == 2 : LogsView {
                        service-name: root.log-service-name;
                        stderr: root.log-stderr;
                        status: root.log-status;
                        lines: root.log-lines;
                        reload => { root.logs-reload(); }
                        set-stderr(v) => { root.logs-set-stderr(v); }
                    }
                    if root.view == 3 : RecoveryView { }
                    if root.view == 4 : SettingsView { }
                }

                // status bar
                Text {
                    text: root.status-text;
                    color: Theme.text-faint;
                    font-size: 12px;
                }
            }
        }
    }

    if root.active-modal == 1 : InstallDialog {
        name <=> root.modal-name;
        display-name <=> root.modal-display;
        application <=> root.modal-application;
        arguments <=> root.modal-arguments;
        working-dir <=> root.modal-working-dir;
        stdout-path <=> root.modal-stdout;
        stderr-path <=> root.modal-stderr;
        start-type <=> root.modal-start-type;
        error: root.modal-error;
        submit => { root.modal-install-submit(); }
        cancel => { root.modal-cancel(); }
        browse-app => { root.modal-browse-app(); }
    }
    if root.active-modal == 2 : EditDialog {
        service-name: root.modal-service-name;
        display-name <=> root.modal-display;
        application <=> root.modal-application;
        arguments <=> root.modal-arguments;
        working-dir <=> root.modal-working-dir;
        stdout-path <=> root.modal-stdout;
        stderr-path <=> root.modal-stderr;
        start-type <=> root.modal-start-type;
        error: root.modal-error;
        submit => { root.modal-edit-submit(); }
        cancel => { root.modal-cancel(); }
        browse-app => { root.modal-browse-app(); }
    }
    if root.active-modal == 3 : RemoveDialog {
        service-name: root.modal-service-name;
        confirm => { root.modal-remove-confirm(); }
        cancel => { root.modal-cancel(); }
    }
    if root.active-modal == 4 : ProcessesDialog {
        service-name: root.modal-service-name;
        rows: root.modal-processes;
        sort-column: root.modal-sort-column;
        sort-ascending: root.modal-sort-ascending;
        close => { root.modal-cancel(); }
        sort-changed(c) => { root.modal-sort-changed(c); }
    }
}
